{
  "name": "kaif-portfolio",
  "version": "2.0.0",
  "private": true,
  "description": "Kaif Hossain — Automation Architect portfolio (HTML + Tailwind CSS + vanilla JS)",
  "scripts": {
    "build:css": "tailwindcss -i ./css/input.css -o ./css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./css/input.css -o ./css/tailwind.css --watch",
    "dev": "npx serve .",
    "build": "npm run build:css"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
